{
  "name": "@theholocron/skills-docs",
  "version": "1.2.0",
  "description": "Documentation content for the @theholocron/skills agent skill registry",
  "homepage": "https://github.com/theholocron/skills/tree/main/packages/skills-docs#readme",
  "bugs": "https://github.com/theholocron/skills/issues",
  "repository": {
